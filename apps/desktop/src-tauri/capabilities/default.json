{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings window: listen to events and call the app commands. No fs, shell, http or dialog plugins (ADR 0001).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-status",
    "allow-get-settings",
    "allow-update-settings",
    "allow-request-engine-swap",
    "allow-list-displays",
    "allow-cancel-turn",
    "allow-debug-point",
    "allow-get-last-request",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-list-models",
    "allow-start-download",
    "allow-cancel-download",
    "allow-get-deny-list",
    "allow-add-deny-entry",
    "allow-remove-deny-entry",
    "allow-reset-deny-list-to-defaults",
    "allow-get-audit-entries",
    "allow-export-audit-log",
    "allow-clear-audit-log",
    "allow-kill-agent",
    "allow-debug-fake-task",
    "allow-agent-start-task",
    "allow-agent-status",
    "allow-update-status",
    "allow-update-check",
    "allow-update-download",
    "allow-update-cancel",
    "allow-update-install"
  ]
}
