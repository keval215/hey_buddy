{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings window: listen to events and call the app commands. No fs, shell, http or dialog plugins (ADR 0001).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-status",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-displays",
    "allow-cancel-turn",
    "allow-debug-point"
  ]
}
